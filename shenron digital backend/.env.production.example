# On the live server only, copy this file to .env and fill in the blank values.
# The backend loads .env; this template is not loaded automatically.
NODE_ENV=production
PORT=5000
# For a reverse proxy running on the same server. Use your platform's host/port if required.
HOST=127.0.0.1
CLIENT_ORIGIN=https://kravsinfotech.com

# Use a separate production database to keep local changes out of the live site.
MONGODB_URI=mongodb+srv://<db-user>:<url-encoded-password>@<cluster-host>/<database>?retryWrites=true&w=majority
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_COOKIE_NAME=sd_admin_session

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASSWORD=
MAIL_FROM=mailer@example.com
